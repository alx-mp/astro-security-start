# build output
dist/

# generated types
.astro/

# Vitest 5 artifact root: reporter output (json, junit, blob, html) and test
# attachments all land here.
.vitest/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles from the wrong package manager. pnpm-lock.yaml is the only one this
# project tracks. Ignoring these does not stop them being written, it stops them
# being committed by accident; scripts/check-lockfiles.mjs is what actually
# fails the build when one shows up.
package-lock.json
npm-shrinkwrap.json
yarn.lock
bun.lock
bun.lockb

# environment variables. .env.example is tracked on purpose and holds no values.
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
