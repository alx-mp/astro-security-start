# Copy to .env and fill in. .env is gitignored; this file is not, so nothing
# real goes in here.
#
# Every variable below is declared in the `env.schema` block of
# astro.config.mjs. Adding one here without adding it there means Astro will not
# type it, will not validate it, and will not stop it from leaking into the
# client bundle.
#
#   context: 'client' -> shipped to the browser, readable by anyone
#   context: 'server' -> stays on the server
#   access:  'secret' -> server only, and Astro refuses to inline it
#
# PUBLIC_ is a promise, not a category. A variable named PUBLIC_API_KEY ends up
# in the JavaScript your visitors download.

# Canonical origin, read by astro.config.mjs for canonical links and sitemaps.
SITE_URL=http://localhost:4325

# Shown in the UI. Public on purpose.
PUBLIC_SITE_NAME=EduAI

# HOST and PORT are read by the standalone server built by @astrojs/node.
# The systemd unit sets them; they are not part of env.schema.
HOST=127.0.0.1
PORT=4325

# --- Backend NestJS ---------------------------------------------------------
# Base URL of the API. Server context: the browser never calls NestJS directly,
# Astro proxies for it, so this address stays out of the client bundle.
API_URL=http://127.0.0.1:3125
API_TIMEOUT_MS=10000
# Service credential for server-to-server calls, if NestJS expects one.
# API_TOKEN=

# --- Reverse proxy ----------------------------------------------------------
# Hostnames this app answers to, comma separated. Feeds security.allowedDomains.
# Leave empty in local dev. Without it behind Caddy, Astro ignores
# X-Forwarded-Host and builds absolute URLs from 127.0.0.1.
ALLOWED_HOSTNAMES=
